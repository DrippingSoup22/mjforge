# mjforge_embed_files(<output.cpp> <symbol> <file> [<symbol> <file> ...])
# Generates a C++ source file containing the given files as byte arrays:
#   extern const unsigned char <symbol>[]; extern const unsigned int <symbol>_size;
function(mjforge_embed_files out_cpp)
  set(args ${ARGN})
  set(content "// Generated by cmake/Embed.cmake. Do not edit.\n#include <cstddef>\n\n")
  list(LENGTH args n)
  math(EXPR last "${n} - 1")
  foreach(i RANGE 0 ${last} 2)
    math(EXPR j "${i} + 1")
    list(GET args ${i} sym)
    list(GET args ${j} file)
    file(READ "${file}" hex HEX)
    string(LENGTH "${hex}" hexlen)
    math(EXPR size "${hexlen} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # Break into lines of ~32 bytes to keep compilers happy.
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" bytes "${bytes}")
    string(APPEND content "extern const unsigned char ${sym}[] = {\n${bytes}\n};\n")
    string(APPEND content "extern const unsigned int ${sym}_size = ${size};\n\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
  endforeach()
  file(WRITE "${out_cpp}.tmp" "${content}")
  file(COPY_FILE "${out_cpp}.tmp" "${out_cpp}" ONLY_IF_DIFFERENT)
  file(REMOVE "${out_cpp}.tmp")
endfunction()
